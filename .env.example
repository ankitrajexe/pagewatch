# .env.example
# ------------
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.

# --- Data directories ---
DATA_DIR=data
# DB_PATH=data/pagewatch.db       (defaults to DATA_DIR/pagewatch.db)

# --- Monitoring limits ---
MIN_INTERVAL_MINUTES=15
MAX_INTERVAL_MINUTES=1440
PAGE_TIMEOUT_SECONDS=45
MAX_RETRIES=3
DOMAIN_DELAY_SECONDS=10
ALLOW_LOCALHOST=true
ROBOTS_SKIP_LOCALHOST=true
DEV_FAST_MODE=false

# --- Web server ---
BASE_URL=http://127.0.0.1:5000

# --- Email (SMTP) — leave blank to disable email alerts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Telegram bot — leave blank to disable Telegram alerts ---
# How to get a token:
# 1. Message @BotFather on Telegram, send /newbot, choose a name and username.
# 2. Paste the provided token below.
# 3. Enter your numeric chat ID in the monitor's Telegram Chat ID field.
TELEGRAM_BOT_TOKEN=

# --- Discord webhooks ---
# Webhook URLs are entered per-monitor in the web UI.
# How to get a Discord webhook URL:
# 1. In Discord: Server Settings (or Channel Settings) -> Integrations -> Webhooks.
# 2. Click 'New Webhook' and click 'Copy Webhook URL'.
# 3. Paste that URL directly into your monitor's settings.
